{
  "include": ["$(MODDABLE)/examples/manifest_base.json"],
  "modules": {
    "*": "./main",
    "pins/*": "$(MODULES)/pins/i2s/*"
  },
  "defines": { "audioOut": { "queueLength": 8 } },
  "platforms": {
